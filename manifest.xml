<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappor"
    xsi:type="MailApp">

    <Id>8d5e6b72-4b4d-4c2e-9a31-7c5f8a21e604</Id>

    <Version>1.0.0.0</Version>

    <ProviderName>Personal</ProviderName>

    <DefaultLocale>es-ES</DefaultLocale>

    <DisplayName DefaultValue="Añadir al calendario"/>

    <Description DefaultValue="Detecta eventos de tus correos y permite añadirlos a Google Calendar."/>

    <IconUrl DefaultValue="https://louisportre-debug.github.io/outlook-calendar/icon-32.png"/>

    <HighResolutionIconUrl DefaultValue="https://louisportre-debug.github.io/outlook-calendar/icon-80.png"/>

    <SupportUrl DefaultValue="https://github.com/louisportre-debug/outlook-calendar"/>

    <AppDomains>
        <AppDomain>https://louisportre-debug.github.io</AppDomain>
    </AppDomains>

    <Hosts>
        <Host Name="Mailbox"/>
    </Hosts>

    <Requirements>
        <Sets>
            <Set Name="Mailbox" MinVersion="1.3"/>
        </Sets>
    </Requirements>

    <FormSettings>

        <Form xsi:type="ItemRead">

            <DesktopSettings>

                <SourceLocation
                    DefaultValue="https://louisportre-debug.github.io/outlook-calendar/taskpane.html"/>

                <RequestedHeight>450</RequestedHeight>

            </DesktopSettings>

        </Form>

    </FormSettings>

    <Permissions>ReadItem</Permissions>

    <Rule xsi:type="Rule" />

    <DisableEntityHighlighting>false</DisableEntityHighlighting>


    <VersionOverrides
        xmlns="http://schemas.microsoft.com/office/mailappor"
        xsi:type="VersionOverridesV1_0">

        <Requirements>

            <bt:Sets DefaultMinVersion="1.3">

                <bt:Set Name="Mailbox"/>

            </bt:Sets>

        </Requirements>


        <Hosts>

            <Host xsi:type="MailHost">

                <DesktopFormFactor>

                    <ExtensionPoint
                        xsi:type="MessageReadCommandSurface">

                        <OfficeTab id="TabDefault">

                            <Group id="calendarGroup">

                                <Label resid="groupLabel"/>


                                <Control
                                    xsi:type="Button"
                                    id="addCalendarButton">

                                    <Label resid="buttonLabel"/>


                                    <Supertip>

                                        <Title resid="buttonLabel"/>

                                        <Description
                                            resid="buttonDescription"/>

                                    </Supertip>


                                    <Icon>

                                        <bt:Image
                                            size="16"
                                            resid="icon16"/>

                                        <bt:Image
                                            size="32"
                                            resid="icon32"/>

                                        <bt:Image
                                            size="80"
                                            resid="icon80"/>

                                    </Icon>


                                    <Action
                                        xsi:type="ShowTaskpane">

                                        <SourceLocation
                                            resid="taskPaneUrl"/>

                                    </Action>

                                </Control>

                            </Group>

                        </OfficeTab>

                    </ExtensionPoint>

                </DesktopFormFactor>

            </Host>

        </Hosts>


        <Resources>

            <bt:Images>

                <bt:Image
                    id="icon16"
                    DefaultValue="https://louisportre-debug.github.io/outlook-calendar/icon-16.png"/>

                <bt:Image
                    id="icon32"
                    DefaultValue="https://louisportre-debug.github.io/outlook-calendar/icon-32.png"/>

                <bt:Image
                    id="icon80"
                    DefaultValue="https://louisportre-debug.github.io/outlook-calendar/icon-80.png"/>

            </bt:Images>


            <bt:Urls>

                <bt:Url
                    id="taskPaneUrl"
                    DefaultValue="https://louisportre-debug.github.io/outlook-calendar/taskpane.html"/>

            </bt:Urls>


            <bt:ShortStrings>

                <bt:String
                    id="groupLabel"
                    DefaultValue="Calendario"/>

                <bt:String
                    id="buttonLabel"
                    DefaultValue="📅 Añadir al calendario"/>

            </bt:ShortStrings>


            <bt:LongStrings>

                <bt:String
                    id="buttonDescription"
                    DefaultValue="Lee este correo y prepara un evento para Google Calendar."/>

            </bt:LongStrings>

        </Resources>

    </VersionOverrides>

</OfficeApp>
